# Settings for `docker compose up` (copy to .env and fill in). Never commit .env.
# Every backend option is listed, with explanations, in backend/.env.example – any of them can be added here.

# --- Docker ---
# Port of the app on this machine (the only port published)
FRONTEND_PORT=3000
# The address people use to open the app; customers' proposal links are built from it
PUBLIC_APP_URL=http://localhost:3000

# Database (internal to Docker; data is kept in the `bcom_db-data` volume). Change the password for production.
POSTGRES_USER=bcom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bcom

# --- AI reader ---
# mock (no AI, bundled samples only) | gemini | openai
AI_PROVIDER=mock
GEMINI_API_KEY=
# true only for a paid key (free-tier keys may let Google use uploads; the app then warns against real invoices)
GEMINI_PAID_KEY=true
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=

# Error reporting to Sentry (optional)
SENTRY_DSN=
