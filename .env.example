# Copy to .env.local and fill in. Never commit .env.local.

# Which engine reads invoices and writes WhatsApp messages:
#   mock   – no AI, reads only the sample invoices in public/samples (default, $0)
#   gemini – Google Gemini API (free tier available)
#   openai – OpenAI API (paid)
AI_PROVIDER=mock

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Tested 18 Nov 2026: flash-lite read the sample PDFs and photo 100% correctly in ~8 s
GEMINI_MODEL=gemini-3.5-flash-lite
# Used automatically when the main model is busy or out of free quota ("none" to turn off)
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# minimal | low | medium | high | default – reading a table needs little reasoning, "low" is much faster
GEMINI_THINKING_LEVEL=low

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra

# Largest invoice file accepted, in MB
MAX_UPLOAD_MB=10