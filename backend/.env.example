# Copy to .env and fill in. Never commit .env.

APP_ENV=development
# Frontend origins allowed to call the API from a browser (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Which engine reads invoices and writes WhatsApp messages:
#   mock   – no AI, reads only the bundled SwiftLine sample PDFs (default, $0)
#   gemini – Google Gemini API (free tier available)
#   openai – OpenAI API (paid)
AI_PROVIDER=mock
# A second reader to try when the first is busy, rate-limited or failing: none | gemini | openai (needs its key)
AI_FALLBACK_PROVIDER=none

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# true only for a paid key: free-tier keys may let Google use uploads, so the app warns against real invoices
GEMINI_PAID_KEY=false
GEMINI_MODEL=gemini-3.5-flash-lite
# Used automatically when the main model is busy or out of free quota ("none" to turn off)
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# minimal | low | medium | high | default – reading a table needs little reasoning, "low" is much faster
GEMINI_THINKING_LEVEL=low

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra

# Longest one AI request may take, and the whole read including retries and the fallback model (seconds)
AI_REQUEST_TIMEOUT_SECONDS=40
AI_TOTAL_TIMEOUT_SECONDS=55

# Largest invoice file accepted, in MB
MAX_UPLOAD_MB=10

# Convert other invoice currencies to AED before comparing (AED per 1 unit). USD is the dirham's fixed peg.
FX_RATES_TO_AED={"USD": 3.6725}

# Requests per minute per client for reading and message writing (the endpoints that call the AI); 0 = off
RATE_LIMIT_PER_MINUTE=20

# Re-uploading the same file returns the earlier reading instead of calling the AI again
EXTRACT_CACHE_SIZE=64
EXTRACT_CACHE_TTL_SECONDS=3600

# Accept only the bundled sample invoices (public demos on a free AI tier)
ALLOW_ONLY_SAMPLE_FILES=false

# PostgreSQL for saved proposals. `make db-up` starts one on port 5440; `make migrate` creates the tables.
DATABASE_URL=postgresql+asyncpg://bcom:bcom@localhost:5440/bcom
# Time zone for "today" in follow-up reminders, and days after "Mark as sent" before a follow-up is due
TIMEZONE=Asia/Dubai
FOLLOW_UP_DAYS=3
# Give the AI short lessons from partners' most frequent corrections on new reads (true/false)
READING_HINTS=true
# Error reporting to Sentry (optional; leave empty to turn off)
SENTRY_DSN=

# Email: proposals sent from the app. Leave SMTP_HOST empty to switch email off.
# For local testing, `docker compose up -d mailpit` catches every email (inbox at http://localhost:8025):
#   SMTP_HOST=localhost  SMTP_PORT=1025  SMTP_SECURITY=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls
EMAIL_FROM=proposals@example.com
EMAIL_FROM_NAME=BCOM Global
# Where the frontend lives, used for the customer's link in emails
PUBLIC_APP_URL=http://localhost:3000
