# Copy to .env.local for local development. Never commit .env.local.

# Where the Next.js server forwards /api/v1/* – the backend as seen from the frontend server.
# Local development: the backend from ../backend (`make run`). In Docker this is set as a build argument.
BACKEND_URL=http://localhost:8000

# Leave empty: the browser then calls this site (/api/v1) and the backend never has to be public.
# Set an absolute URL only to make the browser call a backend directly (the browser tests do this).
NEXT_PUBLIC_API_URL=
